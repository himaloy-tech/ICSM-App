# Optional: enables photo-based food estimates. OpenAI API billing is separate
# from ChatGPT subscriptions, and image requests may incur charges.
OPENAI_API_KEY=

# Optional: enables OAuth and calorie sync from Strava activities.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:8000/api/strava/callback
